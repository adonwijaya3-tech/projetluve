# Configure these in Netlify Dashboard > Site configuration > Environment variables.
# Do not commit real values to Git and never place the service-role key in HTML.
SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
DISCORD_TESTIMONIAL_WEBHOOK=https://discord.com/api/webhooks/REPLACE_WITH_REAL_WEBHOOK
